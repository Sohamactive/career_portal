# Django Settings
SECRET_KEY=your-secret-key-here-minimum-50-characters-long-and-random
DEBUG=True

# Database (for production, configure PostgreSQL/MySQL)
# DATABASE_URL=postgres://user:password@localhost/dbname

# Email Configuration (Gmail example)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Auth0 Configuration (for social login)
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Production Settings (uncomment and configure for production)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
